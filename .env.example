DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require&channel_binding=require"

NODE_ENV=production
PORT=3000

JWT_ACCESS_SECRET=changeme
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGINS=https://iv-raws.vercel.app

REDIS_HOST=your-render-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

S3_ENDPOINT=https://unused.example.com
S3_REGION=us-east-1
S3_BUCKET=unused
S3_ACCESS_KEY_ID=unused
S3_SECRET_ACCESS_KEY=unused
S3_FORCE_PATH_STYLE=true

STRIPE_SECRET_KEY=changeme
STRIPE_WEBHOOK_SECRET=changeme

RAZORPAY_KEY_ID=changeme
RAZORPAY_KEY_SECRET=changeme
RAZORPAY_WEBHOOK_SECRET=changeme

APP_BASE_URL=https://iv-raws.vercel.app
SMTP_HOST=unused.example.com
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IvRaws <no-reply@ivraws.com>"
